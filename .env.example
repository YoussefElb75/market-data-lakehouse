# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Comma-separated literals the pre-commit check must block (account e-mail,
# user id, workspace id, workspace host slug, local user profile path, ...).
MDL_FORBIDDEN=
# Folder with the HWiNFO CSV sensor log used by the CPU thermal guard (optional).
MDL_HWINFO_LOG_DIR=
# Databricks CLI profile holding the workspace host and OAuth tokens.
DATABRICKS_CONFIG_PROFILE=mdl
